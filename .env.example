# ULTIMATE ROBOT TEAM — copy this file to ".env" and fill in your keys.
# NEVER commit the real .env file (it is gitignored).

# Required for the AI robots (brain + content team).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — only needed for the image_maker robot (AI visuals).
# Get one at https://aistudio.google.com/apikey
# NOTE: Imagen 3 image generation through the API typically needs a
# BILLING-ENABLED key — a plain free key often returns a
# permission/billing error. The robot surfaces that real error.
GEMINI_API_KEY=

# Optional — only needed for real Telegram publishing.
# 1. Open Telegram and talk to @BotFather -> /newbot -> copy the token.
# 2. Send one message to your new bot, then open in a browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your chat "id" number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — only needed for real Instagram publishing.
# 1. Create a Meta app (https://developers.facebook.com) with the
#    instagram_content_publish permission, get a user access token.
# 2. Find your Instagram business/creator account ID (the numeric
#    ig_user_id, e.g. via the Graph API Explorer).
IG_ACCESS_TOKEN=
IG_USER_ID=

# Optional — the PUBLIC https URL of the post image.
# Meta's own servers fetch the image from this URL, so a local file
# path will NEVER work here. See README "The public-URL bridge" for
# how to get one. Leave empty to skip Instagram publishing honestly.
IMAGE_PUBLIC_URL=
